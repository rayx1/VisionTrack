<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Camera for physical device camera -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Internet for IP camera RTSP streams -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        required="false" so the app is listed on devices without a physical camera
        (IP camera mode works on such devices).
    -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PersonCounter">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.PersonCounter.Settings"
            android:parentActivityName=".MainActivity" />

    </application>

</manifest>
